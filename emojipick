# Note for Wayland users:
# If use_rofi is not used (meaning set to 0), then script falls back to dmenu.
# Unless the current session is run under Wayland instead X11, then it
# fallsback to wofi. Be careful with running rofi or dmenu under Wayland, as
# they key presses such as arrow keys to the terminal. Therefore I recommend
# using wofi if you are in a Wayland session.

# This variable points to the other script "emojiget.py", that is used to
# retrieve and get a list of available emojis. If it is installed in the $PATH,
# then its filename is enough. Otherwise use a path such as "./emojiget.py" or
# any other fullpath.
emojiget='emojiget.py'

# Name-Size
# font_family='Noto Color Emoji'
font_family='Noto Sans'
font_size='18'

# Path to personal emojis file to display them at top of the dmenu list.
favorites="${HOME}/.myemojis"

# 1=Yes, 0=No
use_rofi=0
copy_to_clipboard=1
show_notification=1
print_emoji=1
lower_case=1
enable_favorites=1

export SCRIPT_DIR=''
SCRIPT_DIR="$(dirname "$(readlink -f "${0}")")"
export PATH=.:${SCRIPT_DIR}:${PATH}

if [[ "${use_rofi}" -eq 1 ]]; then
    if [ -n "${EMOJIPICK_CMD}" ]; then
        cmd_menu=("${EMOJIPICK_CMD}")
    else
        cmd_menu=(
            rofi
            -dmenu
            -l
            15
        )
    fi
    cmd_menu+=(
        -font
        "${font_family} ${font_size}"
    )
elif [[ "${XDG_SESSION_TYPE}" == "wayland" ]]; then
    if [ -n "${EMOJIPICK_CMD}" ]; then
        cmd_menu=("${EMOJIPICK_CMD}")
    else
        cmd_menu=(
            wofi
            --dmenu
            --lines
            15
        )
    fi
    # Note: wofi does not have an option for font selection.
else
    if [ -n "${EMOJIPICK_CMD}" ]; then
        cmd_menu=("${EMOJIPICK_CMD}")
    else
        cmd_menu=(
            dmenu
            -l
            15
        )
    fi
    cmd_menu+=(
        -fn
        "${font_family}-${font_size}"
    )
fi

if [[ "${XDG_SESSION_TYPE}" == "wayland" ]]; then
    cmd_clip=(
        wl-copy
        --trim-newline
    )
else
    cmd_clip=(
        xclip
        -rmlastnl
        -selection
        clipboard
    )
fi

cmd_notify=(
    notify-send
    --urgency=low
)

cmd_emojiget=("${emojiget}")

if [[ "${lower_case}" -eq 1 ]]; then
    cmd_emojiget+=(--lower-case)
fi

if [[ "${enable_favorites}" -eq 1 ]]; then
    cmd_emojiget+=(--input)
    cmd_emojiget+=("${favorites}")
fi

# Run the menu and select an entry.
selected_emoji_line=$(
    "${cmd_emojiget[@]}" | "${cmd_menu[@]}" 2>/dev/null | tr '\n' ' '
)

# Does it start with a double quote?
if [[ ${selected_emoji_line} = \"* ]]; then
    # Select entire contents of quoted string
    emoji="$(
        awk -F '"' '{print $2}' <<<"${selected_emoji_line}"
    )"

else
    # Select first field with awk default separator
    emoji="$(
        awk '{print $1}' <<<"${selected_emoji_line}"
    )"
fi

if [ -n "${emoji}" ]; then
    if [[ "${copy_to_clipboard}" -eq 1 ]]; then
        "${cmd_clip[@]}" <<<"${emoji}"
    fi

    if [[ "${show_notification}" -eq 1 ]]; then
        "${cmd_notify[@]}" "${emoji}"
    fi

    if [[ "${print_emoji}" -eq 1 ]]; then
        printf "%s\n" "${emoji}"
    fi
fi
